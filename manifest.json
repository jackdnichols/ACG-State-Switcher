{
  "manifest_version": 3,
  "name": "State Switcher for acg.aaa.com",
  "version": "1.1",
  "description": "Quickly switch cookies for acg.aaa.com to different states.",
  "permissions": [
    "cookies",
    "activeTab"
  ],
  "host_permissions": [
    "https://acg.aaa.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/aaa.png",
      "48": "icons/aaa.png",
      "128": "icons/aaa.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}