{
  "manifest_version": 3,
  "name": "State Switcher for acg.aaa.com",
  "version": "1.5",
  "description": "Easily manage and switch cookie states to test different user scenarios across websites.",
  "permissions": [
    "cookies",
    "activeTab"
  ],
  "host_permissions": [
    "https://acg.aaa.com/*",
    "https://*.acg.aaa.com/*",
    "https://*.adobeaemcloud.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/aaa.png",
      "48": "icons/aaa.png",
      "128": "icons/aaa.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.acg.aaa.com/*",
        "https://acg.aaa.com/*",
        "https://www.stage1.acg.aaa.com/*",
        "https://stage1.acg.aaa.com/*",
        "https://www.qa1.acg.aaa.com/*",
        "https://qa1.acg.aaa.com/*",        
        "https://www.dev1.acg.aaa.com/*",
        "https://dev1.acg.aaa.com/*",
        "https://www.dev.acg.aaa.com/*",
        "https://dev.acg.aaa.com/*",
        "https://author-p149839-e1583596.adobeaemcloud.com/*",
        "https://author-p149839-e1583546.adobeaemcloud.com/*",        
        "https://author-p149839-e1583595.adobeaemcloud.com/*",
        "https://author-p149839-e1544194.adobeaemcloud.com/*"
      ],
      "js": [
        "content-script.js"
      ]
    }
  ]
}