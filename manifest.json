{
  "manifest_version": 3,
  "name": "ACG Utilities State Switcher",
  "version": "1.98",
  "description": "Dev tool for ACG/Meemic: state switch by ZIP, env links, A/B idea generator, author badge, broken link/image/spelling scanner.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "cookies"
  ],
  "host_permissions": [
    "https://aaa.com/*",
    "https://*.aaa.com/*",
    "https://meemic.com/*",
    "https://*.meemic.com/*",
    "https://meemicfoundation.org/*",
    "https://*.meemicfoundation.org/*",
    "https://author-p149839-e1583596.adobeaemcloud.com/*",
    "https://author-p149839-e1583546.adobeaemcloud.com/*",
    "https://author-p149839-e1583595.adobeaemcloud.com/*",
    "https://author-p149839-e1544194.adobeaemcloud.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon_16.png",
      "48": "icons/icon_48.png",
      "128": "icons/icon_128.png"
    },
    "default_title": "ACG Utilities"
  },
  "content_scripts": [
    {
      "matches": [
        "https://author-p149839-e1583596.adobeaemcloud.com/*",
        "https://author-p149839-e1583546.adobeaemcloud.com/*",
        "https://author-p149839-e1583595.adobeaemcloud.com/*",
        "https://author-p149839-e1544194.adobeaemcloud.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://acg.aaa.com/*",
        "https://*.acg.aaa.com/*"
      ],
      "js": [
        "state-cookie-guard.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://acg.aaa.com/*",
        "https://*.acg.aaa.com/*"
      ],
      "js": [
        "state-keeper.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon_16.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  }
}
